# 관리자 페이지 비밀번호 (필수)
ADMIN_PASSWORD=

# 로그인 쿠키 서명용 난수 (배포 시 자동 생성)
SECRET_KEY=

# 응답·데이터 관리 저장 DB. 비우면 DATA_DIR/responses.db(SQLite) 사용
# 사내 Supabase 발급 접속 문자열: postgresql://app_<YYMMDD>_<코드>_user.<ref>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=
# (선택) 전용 스키마 — 비우면 계정 이름에서 자동으로 읽음(app_<YYMMDD>_<코드>)
DB_SCHEMA=
# (선택) DB 연결 풀 최대 개수 — 계정당 동시 접속 5개 제한이라 기본 3, 최대 4
DB_POOL_MAX=3

# 로컬(http)에서 테스트할 때만 0
COOKIE_SECURE=1
